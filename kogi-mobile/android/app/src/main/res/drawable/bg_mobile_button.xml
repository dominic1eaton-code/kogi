<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1A4D95" />
            <stroke
                android:width="1dp"
                android:color="#66E6FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#153666" />
            <stroke
                android:width="1dp"
                android:color="#4A79BE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
