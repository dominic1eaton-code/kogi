{
  "name": "kogi-desktop",
  "version": "1.0.0",
  "description": "KOGI desktop client — converted from Angular web client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "package-win": "electron-packager . --platform=win32 --arch=x64 --output=dist --overwrite"
  },
  "build": {
    "appId": "com.kogi.desktop",
    "productName": "KOGI",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
